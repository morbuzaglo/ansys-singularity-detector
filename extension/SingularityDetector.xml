<extension version="1" minorversion="0" name="SingularityDetector">

  <author>Mordechay Buzaglo</author>
  <description>Automatic detection and characterisation of stress singularities via automated mesh-refinement convergence studies.</description>
  <guid shortid="SingularityDetector">f27a27e0-ca49-4fa6-87f4-ef972a94c1d7</guid>

  <script src="main.py" />

  <interface context="Mechanical">
    <images>images</images>
    <callbacks>
      <oninit>on_init</oninit>
    </callbacks>

    <toolbar name="SingularityDetector" caption="Singularity Detector">
      <entry name="RunStudy" icon="result" caption="Run Singularity Study">
        <callbacks>
          <onclick>run_singularity_study</onclick>
        </callbacks>
      </entry>
      <entry name="RestoreMesh" icon="result" caption="Restore Original Mesh">
        <callbacks>
          <onclick>restore_original_mesh</onclick>
        </callbacks>
      </entry>
      <entry name="StudySettings" icon="result" caption="Study Settings">
        <callbacks>
          <onclick>show_settings</onclick>
        </callbacks>
      </entry>
      <entry name="AddContours" icon="result" caption="Add Contours">
        <callbacks>
          <onclick>add_contours</onclick>
        </callbacks>
      </entry>
    </toolbar>
  </interface>

  <simdata context="Mechanical">

    <object name="Singularity Study" version="1" caption="Singularity Study" icon="result">
      <property name="MeshLevels" caption="Mesh levels (total, min 3)"
               control="integer" default="4"></property>
      <property name="Ratio" caption="Size ratio  h(i+1) / h(i)"
               control="double" default="0.75"></property>
      <property name="ConfidenceThreshold" caption="Confidence threshold [%]"
               control="double" default="70"></property>
      <property name="ResultQuantity" caption="Result quantity"
               control="select" default="Equivalent (von Mises)">
        <attributes options="Equivalent (von Mises),Maximum Principal,Minimum Principal"></attributes>
      </property>
    </object>

    <result name="Singularity Confidence" version="1"
            caption="Singularity Confidence [%]"
            contextgroup="Singularity Detector" begingroup="true"
            icon="result" location="node" type="scalar">
      <callbacks>
        <evaluate>evaluate_singularity_confidence</evaluate>
      </callbacks>
      <property name="Geometry" caption="Geometry" control="scoping"></property>
    </result>

    <result name="Singularity Confidence (flagged)" version="1"
            caption="Singularity Confidence - flagged only [%]"
            contextgroup="Singularity Detector"
            icon="result" location="node" type="scalar">
      <callbacks>
        <evaluate>evaluate_singularity_confidence_flagged</evaluate>
      </callbacks>
      <property name="Geometry" caption="Geometry" control="scoping"></property>
    </result>

    <result name="Mesh Divergence Evidence" version="1"
            caption="Mesh Divergence Evidence [0-1]"
            contextgroup="Singularity Detector"
            icon="result" location="node" type="scalar">
      <callbacks>
        <evaluate>evaluate_mesh_divergence</evaluate>
      </callbacks>
      <property name="Geometry" caption="Geometry" control="scoping"></property>
    </result>

    <result name="Local Divergence Exponent" version="1"
            caption="Local Divergence Exponent (lambda)"
            contextgroup="Singularity Detector"
            icon="result" location="node" type="scalar">
      <callbacks>
        <evaluate>evaluate_lambda_local</evaluate>
      </callbacks>
      <property name="Geometry" caption="Geometry" control="scoping"></property>
    </result>

    <result name="Geometry Prior" version="1"
            caption="Geometry Prior [0-1]"
            contextgroup="Singularity Detector"
            icon="result" location="node" type="scalar">
      <callbacks>
        <evaluate>evaluate_geometry_prior</evaluate>
      </callbacks>
      <property name="Geometry" caption="Geometry" control="scoping"></property>
    </result>

    <result name="Raw Stress (Original FE Solution)" version="1"
            caption="Raw Stress (Original FE Solution)"
            contextgroup="Singularity Detector" begingroup="true"
            unit="Stress" icon="result" location="node" type="scalar">
      <callbacks>
        <evaluate>evaluate_raw_stress</evaluate>
      </callbacks>
      <property name="Geometry" caption="Geometry" control="scoping"></property>
    </result>

    <result name="Singularity-Filtered Stress" version="1"
            caption="Singularity-Filtered Stress (estimate)"
            contextgroup="Singularity Detector"
            unit="Stress" icon="result" location="node" type="scalar">
      <callbacks>
        <evaluate>evaluate_singularity_filtered_stress</evaluate>
      </callbacks>
      <property name="Geometry" caption="Geometry" control="scoping"></property>
    </result>

  </simdata>

</extension>
